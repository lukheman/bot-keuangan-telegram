[Unit]
Description=Bot Keuangan FastAPI webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/bot-keuangan-telegram
Environment=PYTHONUNBUFFERED=1
ExecStart=/www/wwwroot/bot-keuangan-telegram/.venv/bin/python -m uvicorn app.api.index:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/www/wwwroot/bot-keuangan-telegram

[Install]
WantedBy=multi-user.target
